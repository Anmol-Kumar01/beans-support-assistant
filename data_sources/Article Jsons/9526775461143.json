    "title": "Managers: Correcting Location Pins in Archive",
    "metadata": {
        "url": "https://beansai.zendesk.com/api/v2/help_center/en-us/articles/9526775461143.json",
        "html_url": "https://beansai.zendesk.com/hc/en-us/articles/9526775461143-Managers-Correcting-Location-Pins-in-Archive",
        "author_id": 7501352909335,
        "created_at": "2022-10-13T15:22:21Z",
