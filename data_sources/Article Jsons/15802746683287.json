    "title": "Assign a Direct Dispatcher/Manager to Driver(s)",
    "metadata": {
        "url": "https://beansai.zendesk.com/api/v2/help_center/en-us/articles/15802746683287.json",
        "html_url": "https://beansai.zendesk.com/hc/en-us/articles/15802746683287-Assign-a-Direct-Dispatcher-Manager-to-Driver-s",
        "author_id": 7501352909335,
        "created_at": "2023-07-05T19:43:02Z",
