# Copy to .env and fill in keys. .env is git-ignored; never put real keys in this file.
# In deployed environments these come from the secrets manager.
# Every model is set here; see docs/models.md for why and for other providers.

# ---------------------------------------------------------------------------
# LLM roles. Any OpenAI-compatible chat API: base URL + model + key per role.
# ---------------------------------------------------------------------------

# answer: final answers + tool calling. small: chunk context headers, memory summaries.
# Groq free tier (key: https://console.groq.com/keys)
LLM_ANSWER_BASE_URL=https://api.groq.com/openai/v1
LLM_ANSWER_MODEL=openai/gpt-oss-20b
LLM_ANSWER_API_KEY=your-groq-key

LLM_SMALL_BASE_URL=https://api.groq.com/openai/v1
LLM_SMALL_MODEL=openai/gpt-oss-20b
LLM_SMALL_API_KEY=your-groq-key

# judge: eval scoring. Use a different model family from answer (self-grading bias).
# Gemini free tier (key: https://aistudio.google.com/apikey)
LLM_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_JUDGE_MODEL=gemini-3.5-flash
LLM_JUDGE_API_KEY=your-google-key

# Optional per role (shown for ANSWER; same names for SMALL and JUDGE):
# LLM_ANSWER_THINKING=false                 # off by default for answer/small (latency)
# LLM_ANSWER_THINKING_CONTROL=reasoning_effort   # reasoning_effort | chat_template_kwargs | prompt_switch | none
# LLM_ANSWER_REASONING_EFFORT_OFF=low       # gpt-oss cannot disable reasoning; Qwen3 on Groq: none
# LLM_ANSWER_JSON_MODE=json_schema          # json_schema | json_object | prompt
# LLM_ANSWER_MAX_RETRIES=6                  # 429/5xx retries with backoff
# LLM_ANSWER_MAX_REQUESTS_PER_MINUTE=       # pace below the free-tier limit
# LLM_ANSWER_EXTRA_BODY={}                  # provider-specific request fields (JSON)

# --- Other presets (swap the three lines of a role) ---
# Cerebras free tier:  BASE_URL=https://api.cerebras.ai/v1        MODEL=gpt-oss-120b
# Groq, Qwen3:         BASE_URL=https://api.groq.com/openai/v1    MODEL=qwen/qwen3-32b   REASONING_EFFORT_OFF=none
# Judge on Groq:       BASE_URL=https://api.groq.com/openai/v1    MODEL=openai/gpt-oss-120b
#                      (same family as gpt-oss-20b answers; prefer Gemini when possible)
# Ollama (GPU box):    BASE_URL=http://localhost:11434/v1         MODEL=qwen3:8b   API_KEY=  THINKING_CONTROL=prompt_switch
# vLLM:                BASE_URL=http://localhost:8000/v1          MODEL=Qwen/Qwen3-8B  THINKING_CONTROL=chat_template_kwargs
# Paid OpenAI:         BASE_URL=https://api.openai.com/v1         MODEL=<model id>  API_KEY=sk-...
# Model IDs change: the startup check lists close matches when one is not offered.

# ---------------------------------------------------------------------------
# Retrieval models (hosted)
# ---------------------------------------------------------------------------

# Embeddings: any OpenAI-compatible /embeddings endpoint. Gemini shares the judge's key
# and free-tier quota; ingestion is batched and paced to stay under the free-tier limit.
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=your-google-key
# EMBEDDING_BATCH_SIZE=20                   # chunks per request during ingestion
# EMBEDDING_INGEST_MAX_REQUESTS_PER_MINUTE=4  # free-tier pacing for python -m app.ingest only

# Reranker: Jina (key: https://jina.ai/api-dashboard) or Cohere.
RERANKER_PROVIDER=jina
RERANKER_BASE_URL=https://api.jina.ai/v1
RERANKER_MODEL=jina-reranker-v2-base-multilingual
RERANKER_API_KEY=your-jina-key
# RERANKER_CANDIDATES=20
# Cohere:  RERANKER_PROVIDER=cohere  RERANKER_BASE_URL=https://api.cohere.com/v2  RERANKER_MODEL=rerank-v3.5

# ---------------------------------------------------------------------------
# Database: PostgreSQL + pgvector in Docker. `./scripts/setup_db.sh` creates it.
# These defaults are for local use only; change the password for any shared machine.
# ---------------------------------------------------------------------------
POSTGRES_USER=beans
POSTGRES_PASSWORD=beans_local
POSTGRES_DB=beans_bot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beans:beans_local@localhost:5432/beans_bot

# ---------------------------------------------------------------------------
# Chat server (app/). Answers come from the knowledge base in PostgreSQL:
#   ./scripts/setup_db.sh, then python -m app.ingest
# ---------------------------------------------------------------------------
# BOT_CHAT_BACKEND=rag                      # rag (default) | legacy (proxy the old Node bot)
# BOT_VIDEO_SOURCES_DIR=data_sources/Video Jsons
# BOT_RAG_TOP_K=6                           # chunks given to the answer model
# BOT_RAG_MIN_RERANK_SCORE=0.1              # evidence threshold; calibrate with evals
BOT_LEGACY_BASE_URL=http://localhost:3000
BOT_LEGACY_SOURCES_DIR=data_sources
# BOT_STARTUP_CHECK=false                   # check all models at startup (Phase 2)

# ---------------------------------------------------------------------------
# Evals
# ---------------------------------------------------------------------------
# Questions scored in parallel; keep low on free tiers.
EVAL_CONCURRENCY=1
EVAL_LEGACY_SOURCES_DIR=data_sources
# Baseline from exported traces: python -m evals export-langsmith
EVAL_LANGSMITH_PROJECT=
EVAL_LEGACY_TRACES_PATH=var/langsmith/legacy_runs.jsonl
# EVAL_PII_NAMES_FILE=                      # known names to redact, one per line
# EVAL_MODEL_PRICES={}                      # USD per 1M tokens for paid models; empty = cost N/A

# Live current bot (only if it is running; it needs its own OpenAI key)
EVAL_LEGACY_BASE_URL=http://localhost:3000
# New bot (Phase 2)
EVAL_NEW_BOT_BASE_URL=http://localhost:8000
EVAL_NEW_BOT_TOKEN=

# LangSmith: needed to export traces; tracing of model calls is optional.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
